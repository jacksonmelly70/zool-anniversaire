<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Benjamin · Anniversaire</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<div class="page">
  <header>
    <div class="badge">10 mai 2026</div>
    <h1>Bon anniversaire<br><span class="highlight">Benjamin</span></h1>
    <p class="sub">Komi FEDA · Benzool</p>
  </header>
<section class="photos">
  <div class="photos-label">Ses moments forts</div>
  <div class="grid">
    <div class="photo">
      <img src="/images/photo1.jpg" alt="Benjamin 1">
    </div>
    <div class="photo">
      <img src="/images/photo2.jpg" alt="Benjamin 2">
    </div>
    <div class="photo">
      <img src="/images/photo3.jpg" alt="Benjamin 3">
    </div>
    <div class="photo">
      <img src="/images/photo4.jpg" alt="Benjamin 4">
    </div>
  </div>
</section>

  <div class="consignes">
    <p>Choisis une ou plusieurs options. Tu peux rester anonyme ou donner ton nom.</p>
  </div>

  <form action="/init" method="POST">
    <div class="options-group">
      <div class="option-card" data-type="voeux" onclick="toggleChoice(this)">
        <div><strong>Voeux</strong><br><small>Souhaits pour l'annee</small></div>
        <div class="check"></div>
      </div>
      <div class="option-card" data-type="conseil" onclick="toggleChoice(this)">
        <div><strong>Conseil</strong><br><small>Sagesse ou astuce</small></div>
        <div class="check"></div>
      </div>
      <div class="option-card" data-type="reproche" onclick="toggleChoice(this)">
        <div><strong>Reproche</strong><br><small>Retour bienveillant</small></div>
        <div class="check"></div>
      </div>
    </div>

    <input type="hidden" name="options" id="selectedOptions" value="">

    <div class="identity">
      <label>
        <input type="checkbox" id="anonymeCheck" name="anonyme" onchange="toggleNameField()">
        Rester anonyme
      </label>
      <div id="nameField" class="name-field hidden">
        <input type="text" name="nom" placeholder="Ton nom" autocomplete="off">
      </div>
    </div>

    <button type="submit" class="btn-primary">Continuer</button>
  </form>
</div>

<script>
  let selected = [];
  function toggleChoice(card) {
    const type = card.dataset.type;
    if (selected.includes(type)) {
      selected = selected.filter(t => t !== type);
      card.classList.remove('selected');
    } else {
      selected.push(type);
      card.classList.add('selected');
    }
    document.getElementById('selectedOptions').value = selected.join(',');
  }
  function toggleNameField() {
    const isAnon = document.getElementById('anonymeCheck').checked;
    const nameField = document.getElementById('nameField');
    if (isAnon) nameField.classList.add('hidden');
    else nameField.classList.remove('hidden');
  }
</script>
</body>
</html>